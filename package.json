{
  "name": "ups-sizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pré-dimensionnement d'onduleurs (UPS) d'intérieur — application web statique, sans serveur.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode singlefile",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "catalogs:generate": "node scripts/generate-sample-catalogs.mjs && prettier --write src/catalog/*.json",
    "demo": "tsx scripts/demo-scenarios.ts"
  },
  "dependencies": {
    "dejavu-fonts-ttf": "2.37.3",
    "exceljs": "4.4.0",
    "i18next": "25.10.10",
    "idb-keyval": "6.3.0",
    "jspdf": "3.0.4",
    "jspdf-autotable": "5.0.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "svg2pdf.js": "2.8.1",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "3.2.7"
  }
}
